<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IURIS.APP.GUI.PageCrearCuenta" Title="Crear Cuenta" BackgroundColor="{StaticResource SecundaryColor}" >
    <ContentPage.Content>
        <ScrollView>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <StackLayout Orientation="Horizontal"  VerticalOptions="Center" Grid.Row="1" Margin="10,0,15,0" >
                    <Entry x:Name="EntryNombre" Placeholder="Nombre..." Style="{StaticResource EntryCrearCuenta}" ></Entry>
                </StackLayout>

                <StackLayout Orientation="Horizontal" VerticalOptions="Center" Grid.Row="2" Margin="10,0,15,0" >
                    <Entry x:Name="EntryApellidoPaterno" Placeholder="Apellido Paterno..." Style="{StaticResource EntryCrearCuenta}"></Entry>
                </StackLayout>

                <StackLayout Orientation="Horizontal" VerticalOptions="Center" Grid.Row="3" Margin="10,0,15,0" >
                    <Entry x:Name="EntryApellidoMaterno" Placeholder="Apellido Materno..." Style="{StaticResource EntryCrearCuenta}" ></Entry>
                </StackLayout>

                <StackLayout Orientation="Horizontal" VerticalOptions="Center" Grid.Row="4" Margin="10,0,15,0" >
                    <Entry x:Name="EntryCorreoElectronico" Placeholder="Correo electrónico..." Style="{StaticResource EntryCrearCuenta}"></Entry>
                </StackLayout>

                <StackLayout Orientation="Horizontal" VerticalOptions="Center" Grid.Row="5" Margin="10,0,15,0" >
                    <Entry x:Name="EntryContrasenia" MaxLength="4" Keyboard="Numeric" Placeholder="Contraseña..." Style="{StaticResource EntryCrearCuenta}"></Entry>
                </StackLayout>

                <StackLayout Orientation="Horizontal" VerticalOptions="Center" Grid.Row="6" Margin="10,0,15,0" >
                    <Entry x:Name="EntryConfirmarContrasenia" MaxLength="4" Keyboard="Numeric" Placeholder="Confirmar Contraseña..." Style="{StaticResource EntryCrearCuenta}" ></Entry>
                </StackLayout>



                <StackLayout Grid.Row="7">
                    <Frame
                            BorderColor="White"
                    Padding="0,1,0,1"
                    HasShadow="True"
                    IsClippedToBounds="True"
                    BackgroundColor="{StaticResource PrimaryColor}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" BackgroundColor="Transparent" Text="Ok" x:Name="btnOK" Clicked="BtnOK_Clicked" Style="{StaticResource buttonPrincipal}" ></Button>

                            <Frame
                            Grid.Column="1" 
                            BorderColor="White"
                    Padding="1,0,0,0"
                    HasShadow="True"
                    IsClippedToBounds="True">


                                <Button BackgroundColor="{StaticResource PrimaryColor}"  Text="Cancelar" x:Name="btnCanselar" Clicked="BtnCanselar_Clicked" Style="{StaticResource buttonPrincipal}">
                                </Button>
                            </Frame>
                        </Grid>
                    </Frame>

                </StackLayout>

                <StackLayout Orientation="Vertical" VerticalOptions="Center" HorizontalOptions="FillAndExpand" Grid.Row="8" BackgroundColor="{StaticResource PrimaryColor}" x:Name="stackCodigoDeUsuario">
                    <Label Text="Codigo de usuario" Style="{StaticResource LabelCrearCuenta}"></Label>
                    <Label x:Name="lblCodigoUsuario" Style="{StaticResource LabelCrearCuenta}"></Label>
                </StackLayout>

                <StackLayout HorizontalOptions="Center" Grid.Row="9" >
                    <Image Source="Logo.png" ></Image>
                </StackLayout>
                
            </Grid>
            
        </ScrollView>
    </ContentPage.Content>
</ContentPage>