<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:pv="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView" xmlns:local="clr-namespace:IURIS.MOVIL.Modelos_y_clases"
             mc:Ignorable="d"
             x:Class="IURIS.MOVIL.Detail.PageMotrarCapitulosConCodigos">

    <ContentPage.Resources>
        <Style TargetType="CollectionView">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Selected">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor"
                                        Value="LightSkyBlue" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>
    
    <NavigationPage.TitleView>
        <FlexLayout Direction="Row">

            <SearchBar 
                
                x:Name="SearchViewDetailTitle" 
                VerticalOptions="Center"
                HorizontalOptions="EndAndExpand"
                Placeholder="Titulo, palabras clave..." 
                PlaceholderColor="White"
                TextColor="White"
                CancelButtonColor="White"
                BackgroundColor="Transparent"
                TextChanged="SearchViewDetailTitle_TextChanged"
                SearchButtonPressed="SearchViewDetailTitle_SearchButtonPressed"
                IsVisible="false"
                Margin="-50,0,0,0"
                IsSpellCheckEnabled="True"/>

            <Label x:Name="lblNumResultados" HorizontalOptions="End" Margin="0,0,10,0" IsVisible="false" Style="{StaticResource TextoAMostrarColorBlanco}" VerticalOptions="Center" VerticalTextAlignment="Center" FontSize="Body"></Label>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5" x:Name="GridTituloEIMGBuscador">
                <FlexLayout Grid.Column="0" Direction="Column">

                    <local:CustomLabel x:Name="lblTitle" Style="{StaticResource TextoAMostrarColorBlanco}" HorizontalTextAlignment="Center" HorizontalOptions="Center" FontSize="Body" VerticalOptions="Start" />
                    <Label x:Name="lblCodigo" Style="{StaticResource TextoAMostrarColorBlanco}" FontSize="Small" VerticalOptions="End" VerticalTextAlignment="End" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,2,0,5"/>
                </FlexLayout>

                <Image Grid.Column="1" Source="Buscador.png" WidthRequest="20" HorizontalOptions="End" HeightRequest="20" Margin="10,0,20,0">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                    </Image.GestureRecognizers>
                </Image>
            </Grid>
        </FlexLayout>
    </NavigationPage.TitleView>

    <ContentPage.Content>
        
        <FlexLayout VerticalOptions="Start" JustifyContent="Start" AlignItems="Start" AlignContent="Start">
            <CollectionView x:Name="clltionCapitulos"  SelectionMode="Single" ItemsSource="{Binding ListaCapitulos}" SelectionChanged="clltionCapitulos_SelectionChanged" Margin="10,10">
                <CollectionView.EmptyView>
                    <StackLayout>
                        <Label FontAttributes="Bold"  FontSize="Large" HorizontalOptions="Center" Style="{StaticResource TextoAMostrarColorRojo}">No se encontraron datos</Label>
                    </StackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="5" SnapPointsAlignment="Start" SnapPointsType="MandatorySingle" FlexLayout.AlignSelf="Stretch" FlexLayout.Grow="2" FlexLayout.Shrink="1"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <ContentView>

                            <StackLayout Orientation="Vertical" HorizontalOptions="CenterAndExpand" VerticalOptions="Center" Margin="10,0">
                                <Label Text="{Binding NumCapitulo}" FontSize="Large" Style="{StaticResource TextoAMostrarColorRojo}" HorizontalOptions="Center"></Label>
                                <Label Text="{Binding NombreCapitulo}" FontSize="Large" Style="{StaticResource TextoAMostrarColorRojo}" HorizontalOptions="Center"></Label>
                            </StackLayout>
                        </ContentView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>


            <RefreshView Grid.Row="1" Margin="10,0" IsRefreshing="{Binding IsRefreshing}"
             Command="{Binding RefreshCommand}" FlexLayout.Grow="2">

                <CollectionView FlexLayout.Grow="1" x:Name="cllctionArticulos"  SelectionMode="Single" ItemsSource="{Binding ListaArticulos}" SelectionChanged="cllctionArticulos_SelectionChanged" >
                <CollectionView.EmptyView>
                    <StackLayout>
                        <Label FontAttributes="Bold"  FontSize="Large" HorizontalOptions="Center" Style="{StaticResource TextoAMostrarColorRojo}">No se encontraron datos</Label>
                    </StackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid RowDefinitions="auto,auto" ColumnDefinitions="*,auto" Margin="0,5">
                                    <StackLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalOptions="Start" VerticalOptions="Start" Margin="0,0,30,0" Spacing="0">

                                        <Image Source="LapizNota.png" WidthRequest="20" HeightRequest="20" IsVisible="{Binding NotaAdjunta}" Margin="0,0,5,0">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_2"/>
                                            </Image.GestureRecognizers>
                                        </Image>
                                        
                                        <local:CustomLabel FontSize="17" HorizontalOptions="Start" HorizontalTextAlignment="Start" Style="{StaticResource TextoAMostrarColorRojo}" FontAttributes="Bold">
                                            <local:CustomLabel.Text>
                                                <MultiBinding StringFormat="{}{0}  {1}">
                                                    <Binding Path="NumArticulo" />
                                                    <Binding Path="NombreArticulo" />
                                                </MultiBinding>
                                            </local:CustomLabel.Text>


                                        </local:CustomLabel>

                                    </StackLayout>

                                    <local:CustomLabel Text="{Binding Contenido}" FontSize="Subtitle"  Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10" Style="{StaticResource TextoAMostrarColorRojo}"></local:CustomLabel>
                                <!--<local:CustomEditor  AutoSize="TextChanges" Text="{Binding Contenido}" IsReadOnly="True" FontSize="Subtitle"  Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5" Style="{StaticResource TextoAMostrarColorRojo}"></local:CustomEditor>-->
                            </Grid>

                            <Expander x:Name="expanderGeneric" HorizontalOptions="End" VerticalOptions="Start"  Margin="10,0" Padding="5">
                                
                                <Expander.Header>
                                    <Image Source="Tres_Puntos_Rojos.png" WidthRequest="20" HeightRequest="20" Rotation="180" >
                                        <!--<Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="EsArticuloSeleccionado"/>
                                        </Image.GestureRecognizers>-->
                                    </Image>
                                </Expander.Header>
                                    <Frame BorderColor="{StaticResource ColorTexto}">
                                <StackLayout>
                                        

                                    <Label Text="Clasificación personalizada" Style="{StaticResource TextoAMostrarColorRojo}" FontSize="Large" Margin="5,5">
                                            <Label.GestureRecognizers >
                                                <TapGestureRecognizer Tapped="LblClasificacionPersonalizada"/>
                                            </Label.GestureRecognizers>
                                    </Label>
                                        <Label Text="Mis apuntes" Style="{StaticResource TextoAMostrarColorRojo}" FontSize="Large" Margin="5,5" >
                                            <Label.GestureRecognizers >
                                                <TapGestureRecognizer Tapped="LblApuntes"/>
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <Label Text="Crear Nota" Style="{StaticResource TextoAMostrarColorRojo}" FontSize="Large" Margin="5,5">
                                            <Label.GestureRecognizers >
                                                <TapGestureRecognizer Tapped="LblCrearNota"/>
                                            </Label.GestureRecognizers>
                                        </Label>
                                    
                                </StackLayout>
                                    </Frame>
                            </Expander>

                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            </RefreshView>

            <pv:PancakeView Grid.Row="1" HorizontalOptions="End" VerticalOptions="End" Margin="25" Padding="10" CornerRadius="15">
                <pv:PancakeView.BackgroundGradientStops>
                    <pv:GradientStopCollection>
                        <pv:GradientStop Color="Transparent" Offset="0"/>
                        <pv:GradientStop Color="Transparent" Offset="1"/>
                    </pv:GradientStopCollection>
                </pv:PancakeView.BackgroundGradientStops>
                <Expander Rotation="180" HorizontalOptions="Start" VerticalOptions="End" State="Expanding"
                          ExpandAnimationEasing="{x:Static Easing.SinOut}"
          ExpandAnimationLength="1"
          CollapseAnimationEasing="{x:Static Easing.SinOut}"
          CollapseAnimationLength="1">
                    <Expander.Header >
                        <Image Source="Mas.png" WidthRequest="30" HeightRequest="30" Rotation="180"/>
                    </Expander.Header>
                    <Expander.ContentTemplate>
                        <DataTemplate>
                            <ContentView Margin="0,15,0,0">
                                
                    <StackLayout >
                        <Image Source="avanzar.png" HeightRequest="45" WidthRequest="45" Rotation="180"/>
                        <Image Source="retroseso.png" HeightRequest="45" WidthRequest="45"  Rotation="180"/>
                        <Image Source="copiar.png" HeightRequest="45" WidthRequest="45" Rotation="180"/>
                        <Image Source="lapiz.png" HeightRequest="45" WidthRequest="45" Rotation="180"/>
                        <Image Source="lapiz.png" HeightRequest="45" WidthRequest="45" Rotation="180"/>
                    </StackLayout>
                            </ContentView>
                        </DataTemplate>
                    </Expander.ContentTemplate>
                </Expander>

            </pv:PancakeView>
        
        </FlexLayout>
    </ContentPage.Content>
</ContentPage>