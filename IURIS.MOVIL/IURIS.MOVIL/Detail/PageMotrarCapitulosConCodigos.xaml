<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:IURIS.MOVIL.Modelos_y_clases"
             xmlns:pv="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             mc:Ignorable="d"
             x:Class="IURIS.MOVIL.Detail.PageMotrarCapitulosConCodigos"
             xmlns:controls="clr-namespace:MarcTron.Plugin.Controls;assembly=Plugin.MtAdmob" 
             xmlns:extensions="http://xamarin.com/schemas/2020/toolkit" BindingContext="this">

    <ContentPage.Resources>
        <ResourceDictionary>
            <local:ByteArrayToImageSourceConverter x:Key="ByteArrayToImage" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <NavigationPage.TitleView >
        <FlexLayout Direction="Row">

            <local:CustomEntry 
                
                x:Name="SearchViewDetailTitle" 
                VerticalOptions="Center"
                HorizontalOptions="Start" 
                HorizontalTextAlignment="Start"
                Placeholder="Titulo, palabras clave..." 
                PlaceholderColor="White"
                TextColor="White"
                ClearButtonVisibility="WhileEditing"
                BackgroundColor="Transparent"
                TextChanged="SearchViewDetailTitle_TextChanged"
                Completed="SearchViewDetailTitle_SearchButtonPressed"
                ReturnType="Search"
                IsVisible="false"
                IsSpellCheckEnabled="True"/>
                <!--Margin="-50,0,0,0"-->

            <Label x:Name="lblNumResultados" HorizontalOptions="End" HorizontalTextAlignment="End" Margin="0,0,10,0" IsVisible="false" Style="{StaticResource TextoAMostrarColorBlanco}" VerticalOptions="Center" VerticalTextAlignment="Center" FontSize="Body"></Label>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5" x:Name="GridTituloEIMGBuscador">
                <FlexLayout Grid.Column="0" Direction="Column" AlignContent="Center" AlignItems="Center"  Margin="0,0,0,5">
                    <Label x:Name="lblTitle" MaxLines="1" LineBreakMode="MiddleTruncation" LineHeight="10" Style="{StaticResource TextoAMostrarColorBlanco}" HorizontalTextAlignment="Center" HorizontalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_7"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <Label x:Name="lblCodigo" Style="{StaticResource TextoAMostrarColorBlanco}" FontSize="Small" VerticalOptions="End" VerticalTextAlignment="End" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                </FlexLayout>

                <Image Grid.Column="1" Source="Buscador.png" WidthRequest="20" HorizontalOptions="End" HeightRequest="20" Margin="10,0,20,0">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                    </Image.GestureRecognizers>
                </Image>
            </Grid>
        </FlexLayout>
    </NavigationPage.TitleView>
    
    <Grid>

        <FlexLayout  AlignItems="Start" JustifyContent="Start" >

            <StackLayout FlexLayout.Shrink="1.5"  FlexLayout.Grow="1" FlexLayout.Basis="40%">
                <CarouselView x:Name="clltionCapitulos" ItemsSource="{Binding ListaCapitulos}" IndicatorView="indicatorView" Margin="10,5,10,0" PositionChanged="clltionCapitulos_PositionChanged" BindingContext="{Binding .}" >
                    <CarouselView.EmptyView>
                        <StackLayout>
                            <Label FontAttributes="Bold"  FontSize="Large" HorizontalOptions="Center" Style="{StaticResource TextoAMostrarColorRojo}">No se encontraron datos</Label>
                        </StackLayout>
                    </CarouselView.EmptyView>
                    <CarouselView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" SnapPointsAlignment="Center" SnapPointsType="Mandatory" />
                    </CarouselView.ItemsLayout>
                    <CarouselView.ItemTemplate>
                        <DataTemplate >
                            <ContentView >
                                <FlexLayout JustifyContent="Center" AlignContent="Center" AlignItems="Center"  >
                                    <Label Text="{Binding NumCapitulo}" FontSize="17" Style="{StaticResource TextoAMostrarColorRojo}" FlexLayout.Shrink="0" HorizontalTextAlignment="Center"></Label>
                                    <Label Text="{Binding NombreCapitulo}" FontSize="Subtitle" Style="{StaticResource TextoAMostrarColorRojo}" MaxLines="4" HorizontalTextAlignment="Center"></Label>
                                </FlexLayout>
                                <ContentView.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_3" BindingContext="{Binding .}"/>
                                </ContentView.GestureRecognizers>
                            </ContentView>
                        </DataTemplate>
                    </CarouselView.ItemTemplate>
                </CarouselView>
                <IndicatorView x:Name="indicatorView"
                   IndicatorColor="{StaticResource SecundaryColor}"
                   SelectedIndicatorColor="{StaticResource PrimaryColor}"
                   HorizontalOptions="Center" 
                               VerticalOptions="Start" MaximumVisible="3" 
                            />
            </StackLayout>

            <RefreshView  IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}" FlexLayout.Shrink="2.2" FlexLayout.Grow="1" Margin="0,0,0,60">

                <CollectionView x:Name="cllctionArticulos" ItemsSource="{x:Binding ListaArticulos, Mode=TwoWay}" Margin="10">
                    <CollectionView.EmptyView>
                        <StackLayout>
                            <Label FontAttributes="Bold"  FontSize="Large" HorizontalOptions="Center" Style="{StaticResource TextoAMostrarColorRojo}">No se encontraron datos</Label>
                        </StackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid RowDefinitions="auto,auto,auto" RowSpacing="0"  BindingContext="{Binding .}" >

                                <StackLayout Grid.Row="0" Orientation="Horizontal" VerticalOptions="Start" Spacing="5">

                                    <Image Source="hiper.png" HorizontalOptions="Start" WidthRequest="30" HeightRequest="30" IsVisible="{Binding TieneHipervinculo}"  BindingContext="{Binding .}" VerticalOptions="Center">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_9"/>
                                        </Image.GestureRecognizers>
                                    </Image>

                                    <Image Source="LapizNota.png" WidthRequest="25" HeightRequest="25" IsVisible="{Binding NotaAdjunta}" BindingContext="{Binding .}" VerticalOptions="Center" HorizontalOptions="Start">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_2"/>
                                        </Image.GestureRecognizers>
                                    </Image>

                                    <local:CustomLabeJustifity FontSize="17" MaxLines="1" LineBreakMode="MiddleTruncation" LineHeight="10" HorizontalTextAlignment="Start" Style="{StaticResource TextoAMostrarColorRojo}" FontAttributes="Bold" HorizontalOptions="StartAndExpand" VerticalOptions="Center">
                                        <local:CustomLabeJustifity.Text>
                                            <MultiBinding StringFormat="{}{0}  {1}">
                                                <Binding Path="NumArticulo" />
                                                <Binding Path="NombreArticulo" />
                                            </MultiBinding>
                                        </local:CustomLabeJustifity.Text>
                                    </local:CustomLabeJustifity>

                                    <Image x:Name="jj" Source="Tres_Puntos_Rojos.png" WidthRequest="25" HeightRequest="25" BindingContext="{Binding .}" VerticalOptions="Center" HorizontalOptions="End">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_4"/>
                                        </Image.GestureRecognizers>
                                    </Image>

                                </StackLayout>

                                <local:CustomLabeJustifity BindingContext="{Binding .}" FontSize="Subtitle"  Grid.Row="1" Margin="0,10, 0,0" Style="{StaticResource TextoAMostrarColorRojo}">
                                    <local:CustomLabeJustifity.Triggers>
                                        <DataTrigger TargetType="local:CustomLabeJustifity" Binding="{Binding TieneColorDeTexto}" Value="true">
                                            <Setter Property="IsVisible" Value="false"/>
                                        </DataTrigger>
                                    </local:CustomLabeJustifity.Triggers>
                                    <local:CustomLabeJustifity.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Contenido}"/>
                                        </FormattedString>
                                    </local:CustomLabeJustifity.FormattedText>
                                </local:CustomLabeJustifity>

                                <StackLayout BindableLayout.ItemsSource="{Binding Subrayados}" BindingContext="{Binding .}" Grid.Row="1" Margin="0,10, 0,0" IsVisible="{Binding TieneColorDeTexto}" Spacing="-1"    >
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <local:CustomLabeJustifity BindingContext="{Binding .}" FontSize="Subtitle"  Style="{StaticResource TextoAMostrarColorRojo}" >
                                                <local:CustomLabeJustifity.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding TextoContenidoAnteriror}"/>
                                                        <Span Text="{Binding TextoContenidoSeleccionado}" BackgroundColor="{Binding ColorTextoHex}" TextColor="Black"/>
                                                        <Span Text="{Binding TextoContenidoDespues}"/>
                                                    </FormattedString>
                                                </local:CustomLabeJustifity.FormattedText>
                                            </local:CustomLabeJustifity>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </StackLayout>

                                <CarouselView ItemsSource="{Binding Fotografia}" Grid.Row="2" HorizontalOptions="Center" IsVisible="{Binding FotoAdjunta}" FlexLayout.Basis="20%">
                                    <CarouselView.ItemTemplate>
                                        <DataTemplate  >
                                            <!--<StackLayout Orientation="Vertical" HorizontalOptions="Center" VerticalOptions="Start" Padding="50,10">-->
                                                <FlexLayout JustifyContent="Start" AlignContent="Center" AlignItems="Center" Padding="50,10" >
                                                    <Label Text="{Binding Descripcion}" Style="{StaticResource TextoAMostrarColorRojo}" HorizontalOptions="Center" HorizontalTextAlignment="Center" FlexLayout.Shrink="0"></Label>
                                                <Image Source="{Binding Foto,  Converter={StaticResource ByteArrayToImage}}" HorizontalOptions="Center" FlexLayout.Shrink="1"/>

                                            </FlexLayout>
                                        </DataTemplate>
                                    </CarouselView.ItemTemplate>
                                </CarouselView>

                                <Grid.GestureRecognizers>
                                    <DropGestureRecognizer  Drop="DropGestureRecognizer_DragOver" BindingContext="{Binding .}" DropCommandParameter="{Binding jj}" DropCommand="{Binding this}"></DropGestureRecognizer>
                                </Grid.GestureRecognizers>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </FlexLayout>

        <Image Source="hiper.png" x:Name="Hipertex" HorizontalOptions="Start" VerticalOptions="Start" Margin="20" IsVisible="false" WidthRequest="40" HeightRequest="40">
            <Image.GestureRecognizers>
                <DragGestureRecognizer></DragGestureRecognizer>
            </Image.GestureRecognizers>
        </Image>

        <pv:PancakeView HorizontalOptions="FillAndExpand" VerticalOptions="End" Padding="10,0">
            <pv:PancakeView.BackgroundGradientStops>
                <pv:GradientStopCollection>
                    <pv:GradientStop Color="Transparent" Offset="0"/>
                    <pv:GradientStop Color="Transparent" Offset="1"/>
                </pv:GradientStopCollection>
            </pv:PancakeView.BackgroundGradientStops>
            <Grid RowDefinitions="auto,auto" RowSpacing="2.5">
                
               <extensions:Expander  x:Name="expan" HorizontalOptions="Start" VerticalOptions="End" Direction="Up">
                    <extensions:Expander.Header >
                        <Image Source="hiper.png" HorizontalOptions="Start" WidthRequest="35" HeightRequest="35" />
                    </extensions:Expander.Header>
                    <extensions:Expander.ContentTemplate>
                        <DataTemplate >
                            <ContentView BackgroundColor="{StaticResource PrimaryColor}" AnchorY="+50">
                                <StackLayout x:Name="expanding" HorizontalOptions="End" Margin="10,0" >
                                    <Label Text="Crear hipervinculos" Style="{StaticResource TextoAMostrarColorBlanco}" FontSize="Title" Margin="0,10" >
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="CrearHipervinculo"/>
                                        </Label.GestureRecognizers>
                                    </Label>

                                    <BoxView HorizontalOptions="FillAndExpand" HeightRequest="1" Margin="-5,0" Color="White" FlexLayout.Shrink="0"/>
                                    <Label Text="Mostrar hipervinculos" Style="{StaticResource TextoAMostrarColorBlanco}" FontSize="Title" Margin="0,10">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="MostrarHipervinculo"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </StackLayout>
                            </ContentView>
                        </DataTemplate>
                    </extensions:Expander.ContentTemplate>
                </extensions:Expander>

                <StackLayout Grid.Row="0" x:Name="stakColores" Orientation="Horizontal" HorizontalOptions="Start"  VerticalOptions="End" Margin="60,0,0,0" IsVisible="false">

                    <Ellipse Fill="#F7FE2E" Aspect="Uniform"
         WidthRequest="40"
         HeightRequest="40">
                        <Ellipse.GestureRecognizers>
                            <TapGestureRecognizer Tapped="EllipceColor"/>
                        </Ellipse.GestureRecognizers>
                    </Ellipse>

                    <Ellipse Fill="#60FB36" Aspect="Uniform"
         WidthRequest="40"
         HeightRequest="40">
                        <Ellipse.GestureRecognizers>
                            <TapGestureRecognizer Tapped="EllipceColor"/>
                        </Ellipse.GestureRecognizers>
                    </Ellipse>

                    <Ellipse Fill="#38E9FB" Aspect="UniformToFill"
         WidthRequest="40"
         HeightRequest="40">
                        <Ellipse.GestureRecognizers>
                            <TapGestureRecognizer Tapped="EllipceColor"/>
                        </Ellipse.GestureRecognizers>
                    </Ellipse>

                    <Ellipse Fill="#FAC437" Aspect="UniformToFill"
         WidthRequest="40"
         HeightRequest="40">
                        <Ellipse.GestureRecognizers>
                            <TapGestureRecognizer Tapped="EllipceColor"/>
                        </Ellipse.GestureRecognizers>
                    </Ellipse>

                    <Ellipse Fill="#FB39EB" Aspect="UniformToFill"
         WidthRequest="40"
         HeightRequest="40">
                        <Ellipse.GestureRecognizers>
                            <TapGestureRecognizer Tapped="EllipceColor"/>
                        </Ellipse.GestureRecognizers>
                    </Ellipse>
               
                </StackLayout>

                <extensions:Expander Grid.Row="0" x:Name="expandr" IsEnabled="False" Rotation="180" HorizontalOptions="End" VerticalOptions="End" State="Expanding"
                          ExpandAnimationEasing="{x:Static Easing.SinOut}"
          ExpandAnimationLength="1"
          CollapseAnimationEasing="{x:Static Easing.SinOut}"
          CollapseAnimationLength="1">
                    <extensions:Expander.Header >
                        <Image Source="Mas.png" WidthRequest="35" HeightRequest="35">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ExpaderForPlus"/>
                            </Image.GestureRecognizers>
                        </Image>
                    </extensions:Expander.Header>
                    <extensions:Expander.ContentTemplate>
                        <DataTemplate>
                            <ContentView Margin="0,15,0,0">
                                <StackLayout x:Name="expanding" >
                                    <Image Source="Save.png" HeightRequest="35" WidthRequest="35" Rotation="180">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_5"/>
                                        </Image.GestureRecognizers>
                                    </Image>
                                    <Image Source="eraser.png" HeightRequest="35" WidthRequest="35" Rotation="180">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_6"/>
                                        </Image.GestureRecognizers>
                                    </Image>
                                </StackLayout>
                            </ContentView>
                        </DataTemplate>
                    </extensions:Expander.ContentTemplate>
                </extensions:Expander>

                <controls:MTAdView Grid.Row="1" x:Name="myAds" IsVisible="false" 
                                   AdsId="ca-app-pub-2336879831564913/3076562549" 
                                   VerticalOptions="End"  HorizontalOptions="FillAndExpand" Margin="0,0,0,5">
                    <controls:MTAdView.HeightRequest>
                        <x:OnIdiom>
                            <x:OnIdiom.Phone>50</x:OnIdiom.Phone>
                            <x:OnIdiom.Tablet>90</x:OnIdiom.Tablet>
                            <x:OnIdiom.Desktop>90</x:OnIdiom.Desktop>
                        </x:OnIdiom>
                    </controls:MTAdView.HeightRequest>
                </controls:MTAdView>

            </Grid>
        </pv:PancakeView>
    
    </Grid>
</ContentPage>

