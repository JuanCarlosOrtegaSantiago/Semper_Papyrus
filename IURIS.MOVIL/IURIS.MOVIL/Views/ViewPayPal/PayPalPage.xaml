<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IURIS.MOVIL.Views.ViewPayPal.PayPalPage">
    <ContentPage.Content>
        <StackLayout>
            <Label
                HorizontalOptions="Center"
                Text="PayPal"
                VerticalOptions="CenterAndExpand" />
            <Button
                x:Name="btnPayment"
                Clicked="BtnPayment_OnClicked"
                Text="Pay here" />
        </StackLayout>
    </ContentPage.Content>
</ContentPage>