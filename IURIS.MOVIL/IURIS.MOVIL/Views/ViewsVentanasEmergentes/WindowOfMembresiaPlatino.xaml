<?xml version="1.0" encoding="utf-8" ?>
<Pages:PopupPage  xmlns:Pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
                  xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IURIS.MOVIL.Views.ViewsVentanasEmergentes.WindowOfMembresiaPlatino">

    <Frame BackgroundColor="{StaticResource SecundaryColor}"
           BorderColor="White"
           HasShadow="True"
           IsClippedToBounds="True"
           Padding="2"
           Margin="20"
           HorizontalOptions="FillAndExpand"
           VerticalOptions="CenterAndExpand"
           CornerRadius="3" >

        <Grid RowDefinitions="auto,auto,auto,auto,*,auto" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
            <Image Grid.Row="0" Source="Logo.png" WidthRequest="100" HeightRequest="100"/>
            <Label Grid.Row="1" Style="{StaticResource TextoAMostrarColorBlanco}" HorizontalOptions="Center" FontSize="Title" FontAttributes="Bold">IURIS</Label>
            <Label x:Name="lbltitulo" FontFamily="L_Hand" Grid.Row="2" Style="{StaticResource TextoAMostrarColorBlanco}" HorizontalTextAlignment="Center" FontSize="Title" FontAttributes="Bold"></Label>
            <Label x:Name="lblDescripcion" Grid.Row="3" Style="{StaticResource TextoAMostrarColorBlanco}" HorizontalTextAlignment="Center" FontSize="30" FontAttributes="Bold"></Label>
            <StackLayout Grid.Row="4">
                <RadioButton Text="$49.90 M.N. Mensuales" TextColor="White" FontSize="Large" FontAttributes="Bold" Margin="15,0"></RadioButton>
                
                <Label Style="{StaticResource TextoAMostrarColorBlanco}" FontSize="Large" HorizontalTextAlignment="Center" FontAttributes="Bold">Promoción anual</Label>
                <Label Style="{StaticResource TextoAMostrarColorBlanco}" FontSize="Large" HorizontalTextAlignment="Center" FontAttributes="Bold">Paga anualmente</Label>
                <RadioButton Text="$359.00 M.N. con" TextColor="White" FontSize="Large" FontAttributes="Bold" Margin="15,0"></RadioButton>
                <StackLayout Orientation="Horizontal" VerticalOptions="Center" Margin="50,-15,0,0">
                    <Label Style="{StaticResource TextoAMostrarColorBlanco}" HorizontalTextAlignment="Center" FontAttributes="Bold" FontSize="30" >40%</Label>
                    <Label Style="{StaticResource TextoAMostrarColorBlanco}" FontSize="Large" HorizontalTextAlignment="Center" FontAttributes="Bold" VerticalTextAlignment="Center"> de descuento</Label>
                </StackLayout>
            </StackLayout>
            <Grid Grid.Row="5" ColumnDefinitions="*,*" ColumnSpacing="-1.5" Margin="20">

                <Button Grid.Column="0" x:Name="BtnAceptar" Text="Aceptar" Style="{StaticResource buttonPrincipal}" FontSize="Large"/>
                <Button Grid.Column="1" x:Name="BtnCancelar" Text="Cancelar" Style="{StaticResource buttonPrincipal}" FontSize="Large" Clicked="BtnCancelar_Clicked"/>

            </Grid>
        </Grid>
    </Frame>


</Pages:PopupPage>