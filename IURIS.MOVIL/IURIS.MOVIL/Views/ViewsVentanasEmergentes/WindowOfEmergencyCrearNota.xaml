<?xml version="1.0" encoding="utf-8" ?>
<Pages:PopupPage  xmlns:Pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup" xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:Local="clr-namespace:IURIS.MOVIL.Modelos_y_clases"
                  mc:Ignorable="d"
             x:Class="IURIS.MOVIL.Views.ViewsVentanasEmergentes.WindowOfEmergencyCrearNota">
    <Frame BackgroundColor="{StaticResource PrimaryColor}"
           Padding="6"
           Margin="20"
           HorizontalOptions="FillAndExpand"
           VerticalOptions="Center"
           CornerRadius="5" >

        <Grid RowDefinitions="*,auto" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
            <Local:CustomEditor x:Name="EntryNombreApunte" AutoSize="TextChanges" Grid.Row="0" Placeholder="Escribe una nota o comentario" HorizontalOptions="FillAndExpand" Style="{StaticResource EntryCrearCuenta}" MaxLength="140" Completed="BtnGuardar_Clicked"></Local:CustomEditor>
            <Frame Grid.Row="1" BorderColor="White"  
                    HasShadow="False"
                    IsClippedToBounds="True"
                    Padding="0,1,0,0"
                   HorizontalOptions="FillAndExpand" >

                <StackLayout Orientation="Horizontal" Spacing="-1" BackgroundColor="{StaticResource PrimaryColor}" >
                    <Frame Grid.Row="1" BorderColor="White"  
                           HasShadow="False"
                           IsClippedToBounds="True"
                           Padding="0,0,1,0" 
                           HorizontalOptions="EndAndExpand" VerticalOptions="Center"
                           BackgroundColor="{StaticResource PrimaryColor}">

                        <Button x:Name="BtnGuardar" Text="Guardar" Style="{StaticResource buttonPrincipal}" Clicked="BtnGuardar_Clicked" ></Button>
                    </Frame>

                    <Frame Grid.Row="1" BorderColor="White"  
                           HasShadow="False"
                           IsClippedToBounds="True"
                           Padding="1,0,0,0" 
                           HorizontalOptions="StartAndExpand" VerticalOptions="Center">

                        <Button x:Name="BtnCancelar" Text="Cancelar" Style="{StaticResource buttonPrincipal}" Clicked="BtnCancelar_Clicked" ></Button>

                    </Frame>
                </StackLayout>
            </Frame>
            <!--<Button x:Name="BtnGuardar" Grid.Row="1" Grid.Column="0" Text="Guardar" BackgroundColor="White" TextColor="{StaticResource  ColorTexto}" HorizontalOptions="Start" Margin="20,0" Clicked="BtnGuardar_Clicked"></Button>
            <Button x:Name="BtnCancelar" Grid.Row="1" Grid.Column="1" Text="Cancelar" BackgroundColor="White" TextColor="{StaticResource  ColorTexto}" HorizontalOptions="End" Margin="20,0" Clicked="BtnCancelar_Clicked"></Button>-->
        </Grid>
    </Frame>
</Pages:PopupPage>