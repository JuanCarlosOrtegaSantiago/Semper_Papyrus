<Window x:Class="IURIS.DESKTOP.GUI.ADMIN.WindowUsuarios"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IURIS.DESKTOP.GUI.ADMIN"
        mc:Ignorable="d"
        Title="WindowUsuarios" Height="350" Width="800" WindowStyle="None" WindowStartupLocation="CenterScreen">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFF36060" Offset="0.079"/>
            <GradientStop Color="#FF8F0000" Offset="1"/>
            <GradientStop Color="#FFF05D5D" Offset="0.407"/>
            <GradientStop Color="#FFD74545" Offset="0.666"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
        </Grid.ColumnDefinitions>

        <WrapPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Label FontSize="20" HorizontalAlignment="Center">Nombre:</Label>
            <TextBox x:Name="TxtNombre" Width="250" VerticalContentAlignment="Center" Height="40" FontSize="25"></TextBox>
        </WrapPanel>

        <WrapPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Label FontSize="20" HorizontalAlignment="Center">Dirección:</Label>
            <TextBox x:Name="txtDireccion" Width="250" VerticalContentAlignment="Center" Height="40" FontSize="25"></TextBox>
        </WrapPanel>

        <WrapPanel Orientation="Horizontal"  Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Label FontSize="20" HorizontalAlignment="Center">Correo:</Label>
            <TextBox x:Name="txtCorreo" Width="250" VerticalContentAlignment="Center" Height="40" FontSize="25"></TextBox>
        </WrapPanel>

        <WrapPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="wraCmbx">
            <ComboBox x:Name="cmbxUsuarios" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Height="30" Width="200" Margin="15,5" FontSize="20" SelectionChanged="CmbxUsuarios_SelectionChanged"></ComboBox>
            <CheckBox x:Name="ChkRevision" VerticalAlignment="Center" Click="ChkRevision_Click">Revisión</CheckBox>
        </WrapPanel>

        <WrapPanel Orientation="Vertical" Grid.Row="0" Grid.Column="4" Grid.RowSpan="5" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="Imagenes/Logo.png" Height="250"></Image>
        </WrapPanel>

        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="6">
            <Button Style="{DynamicResource ButtonStyle1}" Width="100" Height="30" Margin="10" FontWeight="Bold" BorderBrush="White" FontSize="15" x:Name="BtnNuevo" Click="BtnNuevo_Click">Nuevo</Button>
            <Button Style="{DynamicResource ButtonStyle1}" Width="100" Height="30" Margin="10" FontWeight="Bold" BorderBrush="White" FontSize="15" x:Name="BtnGuardar" Click="BtnGuardar_Click">Guardar</Button>
            <Button Style="{DynamicResource ButtonStyle1}" Width="100" Height="30" Margin="10" FontWeight="Bold" BorderBrush="White" FontSize="15" x:Name="BtnCancelar" Click="BtnCancelar_Click">Cancelar</Button>
            <Button Style="{DynamicResource ButtonStyle1}" Width="100" Height="30" Margin="10" FontWeight="Bold" BorderBrush="White" FontSize="15" x:Name="BtnEditar" Click="BtnEditar_Click">Editar</Button>
            <Button Style="{DynamicResource ButtonStyle1}" Width="100" Height="30" Margin="10" FontWeight="Bold" BorderBrush="White" FontSize="15" x:Name="BtnEliminar" Click="BtnEliminar_Click">Eliminar</Button>
            <Button Style="{DynamicResource ButtonStyle1}" Width="100" Height="30" Margin="10" FontWeight="Bold" BorderBrush="White" FontSize="15" x:Name="BtnRegresar" Click="BtnRegresar_Click"> Regresar</Button>
        </WrapPanel>
    
    </Grid>
</Window>
