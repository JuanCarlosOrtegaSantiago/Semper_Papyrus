<Window x:Class="IURIS.DESKTOP.GUI.ADMIN.WindowMostrarClasificaciones"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IURIS.DESKTOP.GUI.ADMIN"
        mc:Ignorable="d"
        Title="WindowMostrarListaDeLeyes" Height="450" Width="500" WindowStyle="None" Background="#640404" WindowStartupLocation="CenterScreen" >

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="30"/>
        </Grid.ColumnDefinitions>


        <WrapPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
            <Button x:Name="BtnRegresarAMenuDeOperaciones" Style="{DynamicResource ButtonStyle1}" >
                <WrapPanel>
                    <Image Source="Imagenes/Regreso.png" Width="50" Height="35"></Image>
                </WrapPanel>
            </Button>
        </WrapPanel>

        <Label Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3" FontSize="20" FontWeight="SemiBold" FontStretch="Expanded" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">Clasificación de leyes</Label>

        <WrapPanel Grid.Row="0" Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Button x:Name="BtnCambiarDeAlturaMaximisar" Style="{DynamicResource ButtonStyle1}" >
                <WrapPanel>
                    <Image x:Name="ImgCambiarAlturaMaximisar" Source="Imagenes/maximize.ico" Width="20" Height="20"></Image>
                </WrapPanel>
            </Button>
            <Button x:Name="BtnCambiarDeAlturaMinimizar" Visibility="Collapsed" Style="{DynamicResource ButtonStyle1}" >
                <WrapPanel>
                    <Image x:Name="ImgCambiarAlturaMinimizar" Source="Imagenes/minimize.ico" Width="20" Height="20"></Image>
                </WrapPanel>
            </Button>
        </WrapPanel>
        <Separator Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="10" VerticalAlignment="Bottom"/>
        <ListView x:Name="ListaDeClasificaciones" Grid.Row="2" MinWidth="400" Grid.Column="1" Grid.ColumnSpan="5" HorizontalAlignment="Center" BorderBrush="Transparent" Background="Transparent" ItemsSource="{Binding Leyes}" SelectionChanged="ListaDeClasificaciones_SelectionChanged">
            <!--<ListView.View>
                <GridView>
                    <GridViewColumn Header="Codigo" Width="auto" DisplayMemberBinding="{Binding CodigoLey}" />
                    <GridViewColumn Header="Nombre" Width="auto" DisplayMemberBinding="{Binding NombreLey}" />
                    <GridViewColumn Header="Ultima modificacion" Width="auto" DisplayMemberBinding="{Binding UltimaFechaDeModificacion}" />
                </GridView>
            </ListView.View>-->
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="10,5">

                        <Label Content="{Binding Nombre}" Style="{StaticResource LabelStyle1}"></Label>
                        
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>



    </Grid>
</Window>
