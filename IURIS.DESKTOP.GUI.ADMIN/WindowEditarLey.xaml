            </ListView.ItemContainerStyle>-->

            <ListView.ItemTemplate  >
                <DataTemplate>
                    
                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <WrapPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center" Margin="10,0">

                            <WrapPanel Orientation="Vertical" Margin="20,0">

                                <Label Style="{DynamicResource LabelStyle1}">Nombre del titulo</Label>
                                <TextBox IsEnabled="False" Width="250" Text="{Binding NombreTitulo}" Height="30" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="20"></TextBox>

                            </WrapPanel>

                            <WrapPanel Orientation="Vertical" Margin="20,0">

                                <WrapPanel Orientation="Horizontal">
                                    <Label Style="{DynamicResource LabelStyle1}" FontWeight="Black" Margin="0,0,-5,0">Numero</Label>
                                    <Label Style="{DynamicResource LabelStyle1}" >del titulo</Label>
                                </WrapPanel>
                                <TextBox IsEnabled="False" Text="{Binding NumTitulo}" Width="250" Height="30" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="20"></TextBox>

                            </WrapPanel>

                        </WrapPanel>

                        <WrapPanel Orientation="Horizontal" Grid.Row="1" VerticalAlignment="Center" >
                            <Expander Header="Capitulos" Foreground="White" FontSize="15" Margin="0,10">

                                <ListView SelectionMode="Single" Background="Transparent" HorizontalContentAlignment="Center" MinWidth="400" Grid.Column="1" Grid.ColumnSpan="8" HorizontalAlignment="Center" BorderBrush="Transparent" ItemsSource="{Binding ListaCapitulos}" >
                                    <ListView.ItemContainerStyle>

                                        <Style TargetType="{x:Type ListViewItem}">
                                            <Style.Triggers>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="true" />
                                                    </MultiTrigger.Conditions>
                                                    <MultiTrigger.Setters>
                                                        <Setter Property="FocusManager.IsFocusScope" Value="False" />
                                                    </MultiTrigger.Setters>
                                                </MultiTrigger>
                                            </Style.Triggers>
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListViewItem">
                                                        <Border x:Name="border" Background="Transparent">
                                                            <VisualStateManager.VisualStateGroups>
                                                                <VisualStateGroup x:Name="CommonStates">
                                                                    <VisualState x:Name="Normal" />
                                                                    <VisualState x:Name="Disabled" />
                                                                </VisualStateGroup>
                                                                <VisualStateGroup x:Name="SelectionStates">
                                                                    <VisualState x:Name="Unselected" />
                                                                    <VisualState x:Name="Selected">
                                                                        <Storyboard>
                                                                            <ColorAnimationUsingKeyFrames Storyboard.TargetName="border"
                                                              Storyboard.TargetProperty="(Panel.Background).(SolidColorBrush.Color)">
                                                                                <EasingColorKeyFrame KeyTime="0" Value="LightBlue" />
                                                                            </ColorAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </VisualState>
                                                                    <VisualState x:Name="SelectedUnfocused">
                                                                        <Storyboard>
                                                                            <ColorAnimationUsingKeyFrames Storyboard.TargetName="border"
                                                              Storyboard.TargetProperty="(Panel.Background).(SolidColorBrush.Color)">
                                                                                <EasingColorKeyFrame KeyTime="0" Value="SkyBlue" />
                                                                            </ColorAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </VisualState>
                                                                </VisualStateGroup>
                                                            </VisualStateManager.VisualStateGroups>
                                                            <ContentPresenter/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>

                                    </ListView.ItemContainerStyle>

                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                </Grid.RowDefinitions>

                                                <WrapPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center" Margin="10,0">

                                                    <WrapPanel Orientation="Vertical" Margin="20,0" >

                                                        <Label Style="{DynamicResource LabelStyle1}">Nombre del capitulo</Label>
                                                        <TextBox IsEnabled="False" Text="{Binding NombreCapitulo}" Width="250" Height="30" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="20"></TextBox>

                                                    </WrapPanel>

                                                    <WrapPanel Orientation="Vertical" Margin="20,0">

                                                        <WrapPanel Orientation="Horizontal">
                                                            <Label Style="{DynamicResource LabelStyle1}" FontWeight="Black" Margin="0,0,-5,0">Numero</Label>
                                                            <Label Style="{DynamicResource LabelStyle1}" >del capitulo</Label>
                                                        </WrapPanel>
                                                        <TextBox IsEnabled="False" Text="{Binding NumCapitulo}" Width="250" Height="30" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="20"></TextBox>

                                                    </WrapPanel>

                                                </WrapPanel>

                                                <WrapPanel Orientation="Horizontal" Grid.Row="1" VerticalAlignment="Center">
                                                    
                                                    <Expander Header="Articulos" Foreground="White" FontSize="15" Margin="0,10">
                                                    
                                                        <ListView SelectionMode="Single" Background="Transparent" HorizontalContentAlignment="Center" MinWidth="400" Grid.Column="1" Grid.ColumnSpan="8" HorizontalAlignment="Center" BorderBrush="Transparent" ItemsSource="{Binding ListaArticulos}" >
                                                            <ListView.ItemContainerStyle>

                                                                <Style TargetType="{x:Type ListViewItem}">
                                                                    <Style.Triggers>
                                                                        <MultiTrigger>
                                                                            <MultiTrigger.Conditions>
                                                                                <Condition Property="IsMouseOver" Value="true" />
                                                                            </MultiTrigger.Conditions>
                                                                            <MultiTrigger.Setters>
                                                                                <Setter Property="FocusManager.IsFocusScope" Value="False" />
                                                                            </MultiTrigger.Setters>
                                                                        </MultiTrigger>
                                                                    </Style.Triggers>
                                                                    <Setter Property="Focusable" Value="False"/>
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="ListViewItem">
                                                                                <Border x:Name="border" Background="Transparent">
                                                                                    <VisualStateManager.VisualStateGroups>
                                                                                        <VisualStateGroup x:Name="CommonStates">
                                                                                            <VisualState x:Name="Normal" />
                                                                                            <VisualState x:Name="Disabled" />
                                                                                        </VisualStateGroup>
                                                                                        <VisualStateGroup x:Name="SelectionStates">
                                                                                            <VisualState x:Name="Unselected" />
                                                                                            <VisualState x:Name="Selected">
                                                                                                <Storyboard>
                                                                                                    <ColorAnimationUsingKeyFrames Storyboard.TargetName="border"
                                                              Storyboard.TargetProperty="(Panel.Background).(SolidColorBrush.Color)">
                                                                                                        <EasingColorKeyFrame KeyTime="0" Value="LightBlue" />
                                                                                                    </ColorAnimationUsingKeyFrames>
                                                                                                </Storyboard>
                                                                                            </VisualState>
                                                                                            <VisualState x:Name="SelectedUnfocused">
                                                                                                <Storyboard>
                                                                                                    <ColorAnimationUsingKeyFrames Storyboard.TargetName="border"
                                                              Storyboard.TargetProperty="(Panel.Background).(SolidColorBrush.Color)">
                                                                                                        <EasingColorKeyFrame KeyTime="0" Value="SkyBlue" />
                                                                                                    </ColorAnimationUsingKeyFrames>
                                                                                                </Storyboard>
                                                                                            </VisualState>
                                                                                        </VisualStateGroup>
                                                                                    </VisualStateManager.VisualStateGroups>
                                                                                    <ContentPresenter/>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>

                                                            </ListView.ItemContainerStyle>

                                                            <ListView.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid>

                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="auto"/>
                                                                            <RowDefinition Height="auto"/>
                                                                        </Grid.RowDefinitions>

                                                                        <WrapPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center" Margin="10,0">
                                                                            <WrapPanel Orientation="Vertical" Margin="20,0">

                                                                                <Label Style="{DynamicResource LabelStyle1}">Nombre del articulo</Label>
                                                                                <TextBox IsEnabled="False" Text="{Binding NombreArticulo}" Width="250" Height="30" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="20"></TextBox>

                                                                            </WrapPanel>

                                                                            <WrapPanel Orientation="Vertical" Margin="20,0">

                                                                                <WrapPanel Orientation="Horizontal">
                                                                                    <Label Style="{DynamicResource LabelStyle1}" FontWeight="Black" Margin="0,0,-5,0">Numero</Label>
                                                                                    <Label Style="{DynamicResource LabelStyle1}">del articulo</Label>
                                                                                </WrapPanel>
                                                                                <TextBox IsEnabled="False" Text="{Binding NumArticulo}" Width="250" Height="30" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="20"></TextBox>

                                                                            </WrapPanel>

                                                                        </WrapPanel>

                                                                        <WrapPanel Orientation="Vertical" HorizontalAlignment="Left" Grid.Row="1" >

                                                                        <Label Style="{DynamicResource LabelStyle1}">Contenido</Label>
                                                                            <TextBox IsEnabled="False" Text="{Binding Contenido}" HorizontalScrollBarVisibility="Auto" Width="600" Height="100" VerticalScrollBarVisibility="Auto" FontSize="20" FontWeight="Black" ></TextBox>
                                                                    </WrapPanel>

                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                    
                                                    </Expander>

                                                </WrapPanel>

                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                            </Expander>
                        </WrapPanel>

                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
         
            
        </ListView>

        <WrapPanel Grid.Row="5" Grid.Column="3" Orientation="Horizontal"  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="00,0,120,120">
            <Button x:Name="BtnEditarLey" Background="Transparent" Style="{DynamicResource ButtonStyle1}" BorderBrush="White" Click="BtnEditarLey_Click" >
                <WrapPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="Imagenes/Subir.png" Width="50" Height="50" HorizontalAlignment="Center"></Image>
                    <Label Style="{DynamicResource LabelStyle1}" FontSize="15">Subir cambios</Label>
                </WrapPanel>
            </Button>
        </WrapPanel>


    </Grid>
</Window>
