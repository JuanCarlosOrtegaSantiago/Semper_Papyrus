<Window x:Class="IURIS.DESKTOP.GUI.ADMIN.WindowEditarLey"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IURIS.DESKTOP.GUI.ADMIN"
        mc:Ignorable="d"
        Title="WindowEditarLey" Height="600" Width="800" WindowStyle="None" Background="#640404" WindowStartupLocation="CenterScreen" >

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <!--<RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>-->
            <RowDefinition Height="auto"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="30"/>
        </Grid.ColumnDefinitions>
        
        <WrapPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
            <Button x:Name="BtnRegresarAMenuDeOperaciones" Style="{DynamicResource ButtonStyle1}" Click="BtnRegresarAMenuDeOperaciones_Click">
                <WrapPanel>
                    <Image Source="Imagenes/Regreso.png" Width="50" Height="35"></Image>
                </WrapPanel>
            </Button>
        </WrapPanel>

        <Label x:Name="LblEditarLey" 
               Grid.Row="0" Grid.Column="2" 
               Grid.ColumnSpan="6" FontSize="20" 
               FontWeight="SemiBold" 
               FontStretch="Expanded" 
               Foreground="White" 
               HorizontalAlignment="Center" 
               VerticalAlignment="Center"></Label>
        <Separator Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="10" VerticalAlignment="Bottom"/>

        <!--comienza con los cuadros para ediciones-->

        <WrapPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="8">
            <WrapPanel Orientation="Horizontal">

                <WrapPanel Orientation="Horizontal" Margin="20,0">
                <Label Style="{DynamicResource LabelStyle1}" >Nombre</Label>
            </WrapPanel>
                <TextBox x:Name="txtNombre" Width="250" Height="30" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="20"></TextBox>
            </WrapPanel>
            <WrapPanel Orientation="Horizontal">
                
            <WrapPanel Orientation="Horizontal" Margin="20,0">
                <Label Style="{DynamicResource LabelStyle1}" >Codigo</Label>
            </WrapPanel>
                <TextBox x:Name="txtCodigo" Width="250" Height="30" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="20"></TextBox>
            </WrapPanel>
            
        </WrapPanel>
        
        <ListView x:Name="ListTitulos" 
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.CanContentScroll="False"
                  Grid.Row="3" Grid.RowSpan="2" 
                  Background="Transparent" 
                  Grid.Column="1" Grid.ColumnSpan="8" 
                  HorizontalAlignment="Center" 
                  Selector.IsSelected="False"
                  BorderBrush="Transparent" ItemsSource="{Binding Titulo}"
                  MouseDoubleClick="ListTitulos_MouseDoubleClick">
            
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <WrapPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center" >

                            <WrapPanel Orientation="Vertical" >

                                <Label Style="{DynamicResource LabelStyle1}">Nombre del titulo</Label>
                                <TextBox Width="250" Text="{Binding NombreTitulo}" Height="30" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="20"></TextBox>

                            </WrapPanel>

                            <WrapPanel Orientation="Vertical" >

                                <WrapPanel Orientation="Horizontal">
                                    <Label Style="{DynamicResource LabelStyle1}" FontWeight="Black" Margin="0,0,-5,0">Numero</Label>
                                    <Label Style="{DynamicResource LabelStyle1}" >del titulo</Label>
                                </WrapPanel>
                                <TextBox IsEnabled="False" Text="{Binding NumTitulo}" Width="250" Height="30" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="20"></TextBox>

                            </WrapPanel>

                        </WrapPanel>

                        <WrapPanel Orientation="Horizontal" Grid.Row="1" VerticalAlignment="Center" >
                            <Expander Header="Capitulos" Foreground="White" FontSize="15" Margin="0,10">

                                <ListView SelectionMode="Single" Background="Transparent" HorizontalContentAlignment="Center" MinWidth="400" Grid.Column="1" Grid.ColumnSpan="8" HorizontalAlignment="Center" BorderBrush="Transparent" ItemsSource="{Binding ListaCapitulos}" >
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                </Grid.RowDefinitions>

                                                <WrapPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center" >

                                                    <WrapPanel Orientation="Vertical" >

                                                        <Label Style="{DynamicResource LabelStyle1}">Nombre del capitulo</Label>
                                                        <TextBox Text="{Binding NombreCapitulo}" Width="250" Height="30" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="20"></TextBox>

                                                    </WrapPanel>

                                                    <WrapPanel Orientation="Vertical" >

                                                        <WrapPanel Orientation="Horizontal">
                                                            <Label Style="{DynamicResource LabelStyle1}" FontWeight="Black" Margin="0,0,-5,0">Numero</Label>
                                                            <Label Style="{DynamicResource LabelStyle1}" >del capitulo</Label>
                                                        </WrapPanel>
                                                        <TextBox IsEnabled="False" Text="{Binding NumCapitulo}" Width="250" Height="30" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="20"></TextBox>

                                                    </WrapPanel>

                                                </WrapPanel>

                                                <WrapPanel Orientation="Horizontal" Grid.Row="1" VerticalAlignment="Center">
                                                    
                                                    <Expander Header="Articulos" Foreground="White" FontSize="15" Margin="0,10">
                                                    
                                                        <ListView SelectionMode="Single" Background="Transparent" HorizontalContentAlignment="Center" MinWidth="400" Grid.Column="1" Grid.ColumnSpan="8" HorizontalAlignment="Center" BorderBrush="Transparent" ItemsSource="{Binding ListaArticulos}" >
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid>

                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="auto"/>
                                                                            <RowDefinition Height="auto"/>
                                                                        </Grid.RowDefinitions>

                                                                        <WrapPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center" >
                                                                            <WrapPanel Orientation="Vertical" >

                                                                                <Label Style="{DynamicResource LabelStyle1}">Nombre del articulo</Label>
                                                                                <TextBox IsEnabled="False" Text="{Binding NombreArticulo}" Width="250" Height="30" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="20"></TextBox>

                                                                            </WrapPanel>

                                                                            <WrapPanel Orientation="Vertical" >

                                                                                <WrapPanel Orientation="Horizontal">
                                                                                    <Label Style="{DynamicResource LabelStyle1}" FontWeight="Black" Margin="0,0,-5,0">Numero</Label>
                                                                                    <Label Style="{DynamicResource LabelStyle1}">del articulo</Label>
                                                                                </WrapPanel>
                                                                                <TextBox IsEnabled="False" Text="{Binding NumArticulo}" Width="250" Height="30" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="20"></TextBox>

                                                                            </WrapPanel>

                                                                        </WrapPanel>

                                                                        <WrapPanel Orientation="Vertical" HorizontalAlignment="Left" Grid.Row="1" >

                                                                        <Label Style="{DynamicResource LabelStyle1}">Contenido</Label>
                                                                            <TextBox IsEnabled="False" Text="{Binding Contenido}" HorizontalScrollBarVisibility="Auto" Width="600" Height="100" VerticalScrollBarVisibility="Auto" FontSize="20" FontWeight="Black" ></TextBox>
                                                                    </WrapPanel>

                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                    
                                                    </Expander>

                                                </WrapPanel>

                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                            </Expander>
                        </WrapPanel>

                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <WrapPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="8" Orientation="Horizontal"  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="BtnEditarLey" Background="Transparent" Style="{DynamicResource ButtonStyle1}" BorderBrush="White" Width="80" Height="90" Click="BtnEditarLey_Click" >
                <WrapPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="Imagenes/EditarLey.png" Width="50" Height="50" HorizontalAlignment="Center"></Image>
                    <Label Style="{DynamicResource LabelStyle1}" FontSize="15">Editar</Label>
                </WrapPanel>
            </Button>
        </WrapPanel>


    </Grid>
</Window>
