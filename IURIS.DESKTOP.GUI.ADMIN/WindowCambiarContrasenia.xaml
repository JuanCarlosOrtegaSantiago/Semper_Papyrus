<Window x:Class="IURIS.DESKTOP.GUI.ADMIN.WindowCambiarContrasenia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IURIS.DESKTOP.GUI.ADMIN"
        mc:Ignorable="d"
        Title="WindowCambiarContrasenia" Height="250" Width="300" Background="#640404" MinWidth="250" MinHeight="250" MaxWidth="300" MaxHeight="300" WindowStyle="None" WindowStartupLocation="CenterScreen" >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>

        <WrapPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2">
            <Label Style="{DynamicResource LabelStyle1}" FontSize="15">Ingresa la nueva contraseña</Label>
            <TextBox x:Name="txtContraseniaNueva" Height="30" Width="200" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="15"></TextBox>
        </WrapPanel>

        <WrapPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2">
            <Label Style="{DynamicResource LabelStyle1}" FontSize="15">Confirma la nueva contraseña</Label>
            <TextBox x:Name="txtConfirmarContraseniaNueva" Height="30" Width="200" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="15"></TextBox>
        </WrapPanel>
        <WrapPanel x:Name="WrpErrorDeContrasenia" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="2" Visibility="Collapsed">
            <Label Foreground="LightPink" Margin="5">Las contraseñas no coisiden</Label>
        </WrapPanel>
        <WrapPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Style="{DynamicResource ButtonStyle1}" Width="80" Height="30" BorderBrush="White" Margin="15,0" Click="Button_Click">Aceptar</Button>
            <Button x:Name="BtnCancelar" Style="{DynamicResource ButtonStyle1}" Width="80" Height="30" BorderBrush="White" Margin="15,0" Click="BtnCancelar_Click">Cancelar</Button>
        </WrapPanel>
    </Grid>
</Window>
