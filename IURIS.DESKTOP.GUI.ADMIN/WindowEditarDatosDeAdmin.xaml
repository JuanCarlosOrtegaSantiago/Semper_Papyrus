<Window x:Class="IURIS.DESKTOP.GUI.ADMIN.WindowEditarDatosDeAdmin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IURIS.DESKTOP.GUI.ADMIN"
        mc:Ignorable="d"
         Height="350" Width="800" WindowStyle="None" WindowStartupLocation="CenterScreen" Background="#640404" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
        </Grid.ColumnDefinitions>

        <WrapPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Label Style="{DynamicResource LabelStyle1}" >Nombre:</Label>
            <TextBox x:Name="TxtNombre" Width="250" VerticalContentAlignment="Center" Height="40" FontSize="25"></TextBox>
        </WrapPanel>

        <WrapPanel Orientation="Horizontal"  Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Label Style="{DynamicResource LabelStyle1}" >Correo:</Label>
            <TextBox x:Name="txtCorreo" Width="250" VerticalContentAlignment="Center" Height="40" FontSize="25"></TextBox>
        </WrapPanel>
        
        <WrapPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Label Style="{DynamicResource LabelStyle1}" >Contraseña:</Label>
            <TextBox x:Name="txtContrasenia" Width="250" VerticalContentAlignment="Center" Height="40" FontSize="25"></TextBox>
        </WrapPanel>

        <WrapPanel Orientation="Vertical" Grid.Row="1" Grid.Column="4" Grid.RowSpan="5" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="Imagenes/Logo.png" Height="300"></Image>
        </WrapPanel>

        <WrapPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Grid.RowSpan="2">
            <WrapPanel Orientation="Horizontal" Margin="0,5">
                <Button Style="{DynamicResource ButtonStyle1}" Width="100" Height="30" Margin="25,5" FontWeight="Bold" BorderBrush="White" FontSize="15" x:Name="BtnEditar" Click="BtnEditar_Click">Editar</Button>
                <Button Style="{DynamicResource ButtonStyle1}" Width="100" Height="30" Margin="25,5" FontWeight="Bold" BorderBrush="White" FontSize="15" x:Name="BtnGuardar" Click="BtnGuardar_Click">Guardar</Button>

            </WrapPanel>
            <WrapPanel Orientation="Horizontal" Margin="0,5">

                <Button Style="{DynamicResource ButtonStyle1}" Width="100" Height="30" Margin="25,5" FontWeight="Bold" BorderBrush="White" FontSize="15" x:Name="BtnCancelar" Click="BtnCancelar_Click">Cancelar</Button>
                <Button Style="{DynamicResource ButtonStyle1}" Width="100" Height="30" Margin="25,5" FontWeight="Bold" BorderBrush="White" FontSize="15" x:Name="BtnRegresar" Click="BtnRegresar_Click">Regresar</Button>
            </WrapPanel>
        </WrapPanel>

    </Grid>
</Window>
