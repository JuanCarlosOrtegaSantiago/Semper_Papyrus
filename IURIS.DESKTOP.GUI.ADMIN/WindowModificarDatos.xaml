<Window x:Class="IURIS.DESKTOP.GUI.ADMIN.WindowModificarDatos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IURIS.DESKTOP.GUI.ADMIN"
        mc:Ignorable="d"
        Height="350" Width="800" WindowStyle="None" WindowStartupLocation="CenterScreen" Background="#640404" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
        </Grid.ColumnDefinitions>

            <Label Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="0,5"  Style="{DynamicResource LabelStyle1}" x:Name="lblNombreDeComponente">csa</Label>
        <Separator Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="8" Background="White" VerticalAlignment="Top" ></Separator>

        <WrapPanel Orientation="Horizontal"  Grid.Row="2"  Grid.Column="1" Grid.ColumnSpan="6" VerticalAlignment="Center" HorizontalAlignment="Center">

            <WrapPanel Orientation="Horizontal" Margin="10,0">
                
            <Label Style="{DynamicResource LabelStyle1}" >Nombre:</Label>
            <TextBox x:Name="txtNombre" Width="250" VerticalContentAlignment="Center" Height="40" FontSize="25"></TextBox>
            </WrapPanel>

            <WrapPanel Orientation="Horizontal" Margin="10,0">
                
            <Label Style="{DynamicResource LabelStyle1}" >Numero:</Label>
            <TextBox x:Name="txtNumero" Width="250" VerticalContentAlignment="Center" Height="40" FontSize="25"></TextBox>
            </WrapPanel>
        </WrapPanel>

            <Label Visibility="Collapsed" Grid.Row="3" Grid.RowSpan="3" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{DynamicResource LabelStyle1}" x:Name="lblContenido">Contenido:</Label>
        <RichTextBox Visibility="Collapsed" Grid.Row="3" Grid.RowSpan="3" Grid.Column="2" Grid.ColumnSpan="5" x:Name="RtcTxtContenido" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontSize="15" ></RichTextBox>

        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="6">
            <WrapPanel Orientation="Horizontal" Margin="0,5">
                <Button Style="{DynamicResource ButtonStyle1}" Width="100" Height="30" Margin="25,5" FontWeight="Bold" BorderBrush="White" FontSize="15" x:Name="BtnGuardar" Click="BtnGuardar_Click">Guardar</Button>
                <Button Style="{DynamicResource ButtonStyle1}" Width="100" Height="30" Margin="25,5" FontWeight="Bold" BorderBrush="White" FontSize="15" x:Name="BtnCancelar" Click="BtnCancelar_Click">Cancelar</Button>
            </WrapPanel>
        </WrapPanel>

    </Grid>
</Window>
