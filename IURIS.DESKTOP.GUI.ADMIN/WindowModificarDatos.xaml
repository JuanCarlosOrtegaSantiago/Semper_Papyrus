                    </Style>

                </ListView.ItemContainerStyle>
                -->
                <!--<ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>-->

                <ListView.ItemTemplate >
                    <DataTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">

                            <Image Source="{Binding Foto}" Width="150" Height="150" ></Image>
                            <TextBox IsEnabled="False" Text="{Binding Descripcion}" Width="250" Height="30" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="20"></TextBox>

                        </WrapPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <WrapPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">

                <Button x:Name="btnAddPhoto" HorizontalAlignment="Center" Style="{DynamicResource ButtonStyle1}" Margin="5,0" Click="btnAddPhoto_Click">

                    <WrapPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">

                        <Image x:Name="Img" Source="Imagenes/AddPhoto.png" Width="100" Height="100"></Image>
                        <Label x:Name="lblIMG" Style="{DynamicResource LabelStyle1}" FontSize="10" Margin="0">Seleccionar imagen</Label>

                    </WrapPanel>

                </Button>

                <Grid VerticalAlignment="Center" HorizontalAlignment="Left">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="10*"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Style="{DynamicResource LabelStyle1}" HorizontalAlignment="Left" FontSize="15">Descripción</Label>
                    <RichTextBox Grid.Row="1" x:Name="RtcTxtDescripcionIMG" HorizontalAlignment="Left" Height="100" Width="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontSize="15" ></RichTextBox>

                </Grid>

                <Button x:Name="BtnAddImg" Style="{DynamicResource ButtonStyle1}" Click="BtnAddImg_Click">

                    <WrapPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">

                        <Image Source="Imagenes/add.ico" Width="30" Height="30"></Image>
                        <Label Style="{DynamicResource LabelStyle1}" FontSize="10" Margin="0">Agregar imagen</Label>

                    </WrapPanel>

                </Button>

            </WrapPanel>
        </Grid>


        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="6">
            <WrapPanel Orientation="Horizontal" Margin="0,5">
                <Button Style="{DynamicResource ButtonStyle1}" Width="100" Height="30" Margin="25,5" FontWeight="Bold" BorderBrush="White" FontSize="15" x:Name="BtnEditar" Click="BtnEditar_Click">Editar</Button>
                <Button Style="{DynamicResource ButtonStyle1}" Width="100" Height="30" Margin="25,5" FontWeight="Bold" BorderBrush="White" FontSize="15" x:Name="BtnGuardar" Click="BtnGuardar_Click">Guardar</Button>
                <Button Style="{DynamicResource ButtonStyle1}" Width="100" Height="30" Margin="25,5" FontWeight="Bold" BorderBrush="White" FontSize="15" x:Name="BtnCancelar" Click="BtnCancelar_Click">Cancelar</Button>
            </WrapPanel>
        </WrapPanel>

    </Grid>
</Window>
