<Window x:Class="IURIS.DESKTOP.GUI.ADMIN.WindowEditarFoto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IURIS.DESKTOP.GUI.ADMIN"
        mc:Ignorable="d"
        Height="500" Width="400" WindowStyle="None" WindowStartupLocation="CenterScreen" Background="#640404" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="2.5*"/>
            <RowDefinition Height=".3*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height=".9*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
        </Grid.ColumnDefinitions>

        <WrapPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">

            <Button x:Name="btnAddPhoto" HorizontalAlignment="Center" Style="{DynamicResource ButtonStyle1}" Click="btnAddPhoto_Click">

                <WrapPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image x:Name="Img" Source="Imagenes/AddPhoto.png" Width="150" Height="150"></Image>
                </WrapPanel>

            </Button>
            <Label x:Name="lblIMG" Style="{DynamicResource LabelStyle1}" FontSize="15" Margin="0">Presiona la imagen para cambiar</Label>
        </WrapPanel>

        <WrapPanel Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Label Style="{DynamicResource LabelStyle1}" FontSize="15" VerticalAlignment="Center">Descripción</Label>
            <RichTextBox x:Name="RtcTxtDescripcionIMG" Height="150" Width="250" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontSize="15" ></RichTextBox>

        </WrapPanel>

        <WrapPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" >
            <WrapPanel Orientation="Horizontal" Margin="0,5">
                <Button Style="{DynamicResource ButtonStyle1}" Width="100" Height="30" Margin="25,5" FontWeight="Bold" BorderBrush="White" FontSize="15" x:Name="BtnGuardar" Click="BtnGuardar_Click">Guardar</Button>
                <Button Style="{DynamicResource ButtonStyle1}" Width="100" Height="30" Margin="25,5" FontWeight="Bold" BorderBrush="White" FontSize="15" x:Name="BtnCancelar" Click="BtnCancelar_Click">Cancelar</Button>
            </WrapPanel>
        </WrapPanel>

    </Grid>
</Window>

