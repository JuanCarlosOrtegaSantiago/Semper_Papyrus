<Window x:Class="IURIS.DESKTOP.GUI.ADMIN.WindowEleccionDeUsuarios"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IURIS.DESKTOP.GUI.ADMIN"
        mc:Ignorable="d"
        Title="WindowEleccionDeUsuarios" Height="250" Width="300" Background="#640404" WindowStyle="None" WindowStartupLocation="CenterScreen" >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>

        <WrapPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10">
            <Label Style="{DynamicResource LabelStyle1}" FontSize="15">¿Qué tipo de usuarios desea ver?</Label>
        </WrapPanel>

        <WrapPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2">
            <RadioButton x:Name="RdBtnUsuarioGlobal" VerticalContentAlignment="Center" Margin="10,10" FontSize="15" Foreground="White">Usuario Global</RadioButton>
            <RadioButton x:Name="RdBtnUsuarioAdmin" VerticalContentAlignment="Center" Margin="10,10" FontSize="15" Foreground="White">Usuario Administrador</RadioButton>
        </WrapPanel>
        
        <WrapPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,15">
            <Button Style="{DynamicResource ButtonStyle1}" Width="80" Height="30" BorderBrush="White" Margin="15,0" x:Name="BtnAceptar" Click="BtnAceptar_Click">Aceptar</Button>
            <Button Style="{DynamicResource ButtonStyle1}" Width="80" Height="30" BorderBrush="White" Margin="15,0" x:Name="BtnCancelar" Click="BtnCancelar_Click">Regresar</Button>
        </WrapPanel>
    </Grid>
</Window>
