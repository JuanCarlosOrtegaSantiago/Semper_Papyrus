<Window x:Class="IURIS.DESKTOP.GUI.ADMIN.WindowMenuAdmin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IURIS.DESKTOP.GUI.ADMIN"
        mc:Ignorable="d"
                Height="250" Width="500" Background="#640404" Icon="Imagenes/Logo.png" WindowStyle="None" WindowStartupLocation="CenterScreen" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="2*"/>
            <!--<RowDefinition Height="*"/>-->
            <!--<RowDefinition Height="*"/>-->
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
        </Grid.ColumnDefinitions>
        <WrapPanel Grid.Column="6" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button Style="{DynamicResource ButtonStyle1}" x:Name="BtnSalir" Click="BtnSalir_Click">
                <StackPanel>
                    <Image Source="Imagenes/salir.png" Width="30"/>
                </StackPanel>
            </Button>
        </WrapPanel>
        <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="8" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label Foreground="White" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center">Menú</Label>
        </WrapPanel>

        <WrapPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="10,5" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="BtnUsuarios" Click="BtnUsuarios_Click" Style="{DynamicResource ButtonStyle1}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="Imagenes/Usuarios.png" Width="100" Height="100"></Image>
                    <Label Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold">Usuarios</Label>
                </StackPanel>
            </Button>
        </WrapPanel>

        <WrapPanel Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Margin="10,5" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="BtnContraseniaGenerica" Click="BtnContraseniaGenerica_Click" Style="{DynamicResource ButtonStyle1}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="Imagenes/CambiarContrasenia.png"  Width="100" Height="100"></Image>
                    <Label Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold">Contraseña genérica</Label>
                </StackPanel>
            </Button>
        </WrapPanel>

        <WrapPanel Grid.Row="2" Grid.Column="5" Grid.ColumnSpan="2" Margin="10,5" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="BtnEditarInformacion" Style="{DynamicResource ButtonStyle1}" Click="BtnEditarInformacion_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="Imagenes/EditarPerfil.png"  Width="100" Height="100"></Image>
                    <Label Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold">Editar perfil</Label>
                </StackPanel>
            </Button>
        </WrapPanel>


    </Grid>
</Window>
